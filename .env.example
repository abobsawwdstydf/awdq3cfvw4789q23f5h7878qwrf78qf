# ============================================
# Nexo Messenger - Ultra Secure Configuration
# 30 этапов шифрования + STUN пул (200+)
# ============================================

# Server
NODE_ENV=production
PORT=3001

# ============================================
# КЛЮЧИ ШИФРОВАНИЯ (Генерировать!)
# ============================================

# JWT Secret (64 символа)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=36427af4278b7198dc850c7235c4c85feda7275d89fe3d360c79a1af94579765

# Encryption Key (64 hex символа) - для базового шифрования
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=36427af4278b7198dc850c7235c4c85feda7275d89fe3d360c79a1af94579765

# Master Key (64 символа) - для многоуровневого шифрования
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# БАЗЫ ДАННЫХ
# ============================================

# Neon DB (PostgreSQL)
DATABASE_URL="postgresql://user:password@host.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Redis Cloud (обязательно для звонков)
REDIS_URL="redis://default:password@host:port"

# ============================================
# DISCORD - Хранение файлов
# ============================================
DISCORD_WEBHOOK_URLS=https://discord.com/api/webhooks/111/aaa,https://discord.com/api/webhooks/222/bbb

# ============================================
# TELEGRAM - Хранение файлов
# ============================================
TELEGRAM_BOT_TOKENS=token1,token2,token3
TELEGRAM_CHANNEL_IDS=-100111,-100222,-100333

# ============================================
# CORS и лимиты
# ============================================
CORS_ORIGINS=*
MAX_FILE_SIZE=53687091200
CHUNK_SIZE=20971520
MAX_REGISTRATIONS_PER_IP=22
